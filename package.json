{
  "name": "@dgtalbug/iris",
  "version": "0.1.0",
  "description": "Visual, versioned HTML docs for AI coding work.",
  "type": "module",
  "bin": {
    "iris": "./dist/src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "token-lint": "node ./scripts/token-lint.mjs",
    "prepare": "npm run build"
  },
  "runtimeDependencyRationale": {
    "ajv": "JSON Schema validation for strict contract enforcement"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "24.4.0",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}

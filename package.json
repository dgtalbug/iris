{
  "name": "@dgtalbug/iris",
  "version": "0.4.0",
  "description": "Local-first visual documentation workspace for AI coding work.",
  "keywords": [
    "ai coding agents",
    "agent workflow",
    "cli",
    "developer tools",
    "documentation",
    "local-first",
    "openspec",
    "offline",
    "project documentation",
    "static html"
  ],
  "homepage": "https://github.com/dgtalbug/iris#readme",
  "bugs": {
    "url": "https://github.com/dgtalbug/iris/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgtalbug/iris.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "iris": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "schemas",
    "templates/agents",
    "templates/project",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "token-lint": "node ./scripts/token-lint.mjs",
    "html-check": "node ./scripts/html-check.mjs",
    "prepack": "tsc -p tsconfig.json",
    "smoke:install": "node ./scripts/install-smoke.mjs",
    "release:check": "pnpm lint && pnpm format && pnpm token-lint && pnpm typecheck && pnpm test && pnpm html-check && pnpm smoke:install"
  },
  "runtimeDependencyRationale": {
    "ajv": "JSON Schema validation for strict contract enforcement",
    "lucide": "Icon geometry serialised to inline SVG at generation time; never loaded by a generated page",
    "markdown-it": "Generation-time semantic Markdown rendering with embedded HTML disabled",
    "mermaid": "Pinned browser runtime copied locally by iris vendor for strict offline diagram rendering"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "lucide": "1.33.0",
    "markdown-it": "15.0.0",
    "mermaid": "11.17.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "sections"],
  "properties": {
    "type": { "const": "feature" },
    "sections": {
      "type": "object",
      "required": ["problem", "goal", "tasks"],
      "properties": {
        "problem": {
          "type": "object",
          "required": ["md"],
          "properties": { "md": { "type": "string" } }
        },
        "goal": {
          "type": "object",
          "required": ["md"],
          "properties": { "md": { "type": "string" } }
        },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hld": {
              "type": "object",
              "required": ["md"],
              "properties": { "md": { "type": "string" } }
            },
            "lld": {
              "type": "object",
              "required": ["md"],
              "properties": { "md": { "type": "string" } }
            }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "done"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "done": { "type": "boolean" }
            }
          }
        },
        "blueprint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tldr": { "type": "string" },
            "question": { "type": "string" },
            "map": { "type": "string" },
            "territory": { "type": "string" },
            "findings": { "type": "string" },
            "numbers": { "type": "string" },
            "paths": { "type": "string" },
            "risks": { "type": "string" },
            "proposal": { "type": "string" },
            "appendix": { "type": "string" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "sections"],
  "properties": {
    "type": { "const": "bug" },
    "sections": {
      "type": "object",
      "required": ["symptom", "severity", "timeline"],
      "properties": {
        "symptom": {
          "type": "object",
          "required": ["md"],
          "properties": { "md": { "type": "string" } }
        },
        "severity": { "type": "string", "enum": ["p0", "p1", "p2", "p3"] },
        "timeline": {
          "type": "object",
          "required": ["events"],
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["t", "title", "level"],
                "properties": {
                  "t": { "type": "string" },
                  "title": { "type": "string" },
                  "level": { "type": "string", "enum": ["info", "warn", "error"] }
                }
              }
            }
          }
        }
      }
    }
  }
}

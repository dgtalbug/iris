{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "sections"],
  "properties": {
    "type": { "const": "report" },
    "sections": {
      "type": "object",
      "required": ["summary", "open_items", "promotable_as"],
      "properties": {
        "summary": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
        "open_items": {
          "type": "object",
          "required": ["md"],
          "properties": { "md": { "type": "string" } }
        },
        "promotable_as": {
          "type": "array",
          "items": { "type": "string", "enum": ["feature", "bug", "idea"] }
        },
        "blueprint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tldr": { "type": "string" },
            "question": { "type": "string" },
            "map": { "type": "string" },
            "territory": { "type": "string" },
            "findings": { "type": "string" },
            "numbers": { "type": "string" },
            "paths": { "type": "string" },
            "risks": { "type": "string" },
            "proposal": { "type": "string" },
            "appendix": { "type": "string" }
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "title", "labels", "series"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["bar", "line", "doughnut"] },
              "title": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "series": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "values"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "values": { "type": "array", "items": { "type": "number" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

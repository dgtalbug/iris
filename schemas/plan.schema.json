{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "sections"],
  "properties": {
    "type": { "const": "plan" },
    "sections": {
      "type": "object",
      "required": ["goal", "steps"],
      "properties": {
        "goal": {
          "type": "object",
          "required": ["md"],
          "properties": { "md": { "type": "string" } }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        },
        "blueprint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tldr": { "type": "string" },
            "question": { "type": "string" },
            "map": { "type": "string" },
            "territory": { "type": "string" },
            "findings": { "type": "string" },
            "numbers": { "type": "string" },
            "paths": { "type": "string" },
            "risks": { "type": "string" },
            "proposal": { "type": "string" },
            "appendix": { "type": "string" }
          }
        }
      }
    }
  }
}
